# Activates the Exposed Copper Shrine

# Plays sound at coords
playsound minecraft:block.copper_chest.open block @a 987 12 987 3 0.75 0.25

# Places activated Exposed Copper Shrine structure at coords
place template projectcopper:activated_exposed_shrine 985 10 985

# Place the blocked pressure plate above the shrine
place template projectcopper:shrine_plate_blocked 987 15 987