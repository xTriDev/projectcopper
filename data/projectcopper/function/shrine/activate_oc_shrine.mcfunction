# Activates the Oxidized Copper Shrine

# Plays sound at coords
playsound minecraft:block.copper_chest_oxidized.open block @a 1013 12 987 3 0.75 0.25

# Places activated Oxidized Copper Shrine structure at coords
place template projectcopper:activated_oxidized_shrine 1011 10 985

# Place the blocked pressure plate above the shrine
place template projectcopper:shrine_plate_blocked 1013 15 987